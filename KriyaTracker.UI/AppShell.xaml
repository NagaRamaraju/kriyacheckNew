<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="KriyaTracker.UI.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:KriyaTracker.UI"
    Title="KriyaTracker.UI">

    <TabBar>
        <Tab Title="Dashboard" Icon="dotnet_bot.png">
            <ShellContent Route="MainPage" ContentTemplate="{DataTemplate local:MainPage}" />
        </Tab>
        <Tab Title="Practice" Icon="dotnet_bot.png">
            <ShellContent Route="SessionPage" ContentTemplate="{DataTemplate local:SessionPage}" />
        </Tab>
    </TabBar>

</Shell>
